{
  "env": {
    {{ if eq .claude_mode "bedrock" }}
      "CLAUDE_CODE_USE_BEDROCK": "1",
      "AWS_PROFILE": {{ .claude_aws_profile | quote }},
      "AWS_REGION": "us-east-1",
      "ANTHROPIC_MODEL": {{ .claude_model | quote }},
      "ANTHROPIC_SMALL_FAST_MODEL": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
    {{ end }}
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "500000",
    "MAX_THINKING_TOKENS": "10240"
  },
  "permissions": {
    "allow": [
      "Bash(cd:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run task lint)",
      "Bash(uv run task format)",
      "Bash(uv run task type-check)",
      "Bash(uv run task test)",
      "Bash(uv run make lint)",
      "Bash(uv run make format)",
      "Bash(uv run make type-check)",
      "Bash(uv run make test)",
      "Bash(terraform plan)",
      "Bash(terraform validate)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Read(.env.template)",
      "Read(~/.zshrc)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(git checkout:*)",
      "Bash(git push -f)",
      "Bash(git push --force)",
      "Bash(git push --force:*)",
      "Bash(git stash)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git -C:*)",
      "Bash(sudo rm:*)",
      "Bash(rmdir:*)",
      "Bash(xargs rm:*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Bash(python -m:*)",
      "Bash(python3 -m:*)",
      "Bash(python -c:*)",
      "Bash(python3 -c:*)",
      "Bash(uv --directory:*)",
      "Bash(uv run --directory:*)",
      "Bash(uv run black:*)",
      "Bash(uv run python -m:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run ruff format:*)",
      "Bash(uvx:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy)",
      "Bash(terraform -chdir:*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(id_rsa*)",
      "Read(*.key)",
      "Read(*.pem)"
    ],
    "defaultMode": "default"
  },
  {{ if eq .claude_mode "bedrock" }}
    "awsAuthRefresh": "aws sso login --sso-session {{ .SSO_SESSION_NAME }}"
  {{ end }}
  "model": {{ .claude_model | quote }},
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); cwd=$(pwd); user=$(whoami); host=$(hostname -s); git_info=\"\"; [ -d .git ] && git_branch=$(git branch --show-current 2>/dev/null) && [ -n \"$git_branch\" ] && git_info=\" ($git_branch)\"; model_id=$(echo \"$input\" | jq -r '.model.id // empty'); model_info=\"\"; if [ -n \"$model_id\" ]; then case \"$model_id\" in *haiku*) model_short=\"haiku\";; *sonnet*) model_short=\"sonnet\";; *opus*) model_short=\"opus\";; *) model_short=$(echo \"$model_id\" | grep -oE '(haiku|sonnet|opus)' | head -n1);; esac; [ -n \"$model_short\" ] && model_info=\" [$model_short]\"; fi; total_in=$(echo \"$input\" | jq -r '.context_window.total_input_tokens // 0'); total_out=$(echo \"$input\" | jq -r '.context_window.total_output_tokens // 0'); context_size=$(echo \"$input\" | jq -r '.context_window.context_window_size // 0'); used_pct=$(echo \"$input\" | jq -r '.context_window.used_percentage // 0'); context_info=\"\"; if [ \"$context_size\" -gt 0 ]; then in_k=$((total_in / 1000)); out_k=$((total_out / 1000)); size_k=$((context_size / 1000)); context_info=$(printf \" [in:%dk out:%dk / %dk, %d%%]\" \"$in_k\" \"$out_k\" \"$size_k\" \"$used_pct\"); fi; fmt_epoch() { date -r \"$1\" \"+$2\" 2>/dev/null || date -d \"@$1\" \"+$2\" 2>/dev/null; }; now=$(date +%s); five_rem=$(echo \"$input\" | jq -r 'if .rate_limits.five_hour then (100 - .rate_limits.five_hour.used_percentage) else empty end'); five_reset_at=$(echo \"$input\" | jq -r '.rate_limits.five_hour.resets_at // empty'); week_rem=$(echo \"$input\" | jq -r 'if .rate_limits.seven_day then (100 - .rate_limits.seven_day.used_percentage) else empty end'); week_reset_at=$(echo \"$input\" | jq -r '.rate_limits.seven_day.resets_at // empty'); rate_info=\"\"; if [ -n \"$five_rem\" ]; then five_reset_str=\"\"; if [ -n \"$five_reset_at\" ]; then diff=$((five_reset_at - now)); [ \"$diff\" -lt 0 ] && diff=0; fh=$((diff / 3600)); fm=$(((diff % 3600) / 60)); five_reset_str=$(printf \" (reset %dh%02dm後)\" \"$fh\" \"$fm\"); fi; rate_info=\"${rate_info}5h:$(printf '%.0f' \"$five_rem\")%${five_reset_str}\"; fi; if [ -n \"$week_rem\" ]; then week_reset_str=\"\"; if [ -n \"$week_reset_at\" ]; then week_reset_str=\" (reset $(fmt_epoch \"$week_reset_at\" \"%m/%d %H:%M\"))\"; fi; rate_info=\"${rate_info:+$rate_info }7d:$(printf '%.0f' \"$week_rem\")%${week_reset_str}\"; fi; line1=$(printf \"\\033[01;32m%s@%s\\033[00m:\\033[01;34m%s\\033[00m%s\\033[35m%s\\033[00m\\033[33m%s\\033[00m\" \"$user\" \"$host\" \"$cwd\" \"$git_info\" \"$model_info\" \"$context_info\"); if [ -n \"$rate_info\" ]; then printf \"%s\\n\\033[36m%s\\033[00m\" \"$line1\" \"$rate_info\"; else printf \"%s\" \"$line1\"; fi"
  },
  "enabledPlugins": {
    "slack@claude-plugins-official": true,
    "notion@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
  },
  "language": "Japanese",
  "effortLevel": "high"
}
