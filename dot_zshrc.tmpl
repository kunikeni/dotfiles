## git
source ~/.zsh/git-prompt.sh
GIT_PS1_SHOWDIRTYSTATE=true
GIT_PS1_SHOWUNTRACKEDFILES=true
GIT_PS1_SHOWSTASHSTATE=true
GIT_PS1_SHOWUPSTREAM=auto

## functions
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	command rm -f -- "$tmp"
}

on_demand_completion() {
  local cmd_name=$1
  local completion_command=$2
  local function_name="_${cmd_name}"
  local comp_cmd_name="${completion_command%% *}"

  eval "function $function_name() {
    if ! command -v "$comp_cmd_name" &> /dev/null; then
      return
    fi
    unfunction '$function_name'
    eval \"\$(eval $completion_command)\"
    \$_comps[$cmd_name]
  }"

  compdef $function_name $cmd_name
}

cdf() {
  local sel
  sel=$(fd) || return

  if [ -d "$sel" ]; then
    cd "$sel"
  elif [ -f "$sel" ]; then
    cd "$(dirname "$sel")"
  fi
}

## export
export HOMEBREW_GITHUB_API_TOKEN={{ .HOMEBREW_GITHUB_API_TOKEN | quote }}
export PATH="$HOME/.local/bin:$PATH"
export PATH="/opt/homebrew/bin:$PATH"
export PATH="$HOME/.local/share/mise/shims:$PATH"
### MANAGED BY RANCHER DESKTOP START (DO NOT EDIT)
[ -d "$HOME/.rd/bin" ] && export PATH="$HOME/.rd/bin:$PATH"
### MANAGED BY RANCHER DESKTOP END (DO NOT EDIT)

## alias
alias aws_sso='aws sso login --sso-session {{ .SSO_SESSION_NAME }}'
alias cl="clear"
if [[ ! -t 0 ]]; then
  alias rm='trash'
fi
alias g='git'
alias gp='git pull'
alias ls='eza --icons=auto'
alias ll='eza --icons=auto -al --group-directories-first'
alias tree='eza --icons=auto -al -T -L 2'
alias vim='nvim'
alias vibe='PORT=3000 npx vibe-kanban'
if [ -S "$HOME/.rd/docker.sock" ]; then
  alias ctop="DOCKER_HOST=unix://$HOME/.rd/docker.sock ctop"
  alias ctops="DOCKER_HOST=unix://$HOME/.rd/docker.sock ctop -s mem"
else
  alias ctops='ctop -s mem'
fi
alias fd='fd -H | fzf --height 30% --border'

## completion
if [ -x "$(command -v brew)" ]; then
  fpath=($(brew --prefix)/share/zsh-completions $fpath)
fi

add_mise_completion_path() {
  local install_dir

  if ! command -v mise > /dev/null 2>&1; then
    return
  fi

  install_dir=$(mise where "$1" 2> /dev/null) || return
  fpath=("$install_dir"/**/"$2"(N) $fpath)
}

add_mise_completion_path fd autocomplete
add_mise_completion_path yazi completions
unfunction add_mise_completion_path

# 初期化
autoload bashcompinit && bashcompinit
autoload -Uz compinit
compinit

if [ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
  source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
elif [ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

# AWS CLI
if (( $+commands[aws] && $+commands[aws_completer] )); then
  complete -C "$commands[aws_completer]" aws
fi

# bat
if (( $+commands[bat] )); then
  eval "function _bat() { $(bat --completion zsh) }"
  compdef _bat bat
fi

# chezmoi
on_demand_completion 'chezmoi' 'chezmoi completion zsh'

# Docker CLI
on_demand_completion 'docker' 'docker completion zsh'

# GitHub CLI
on_demand_completion 'gh' 'gh completion -s zsh'

# ripgrep
on_demand_completion 'rg' 'rg --generate complete-zsh'

# mise
if (( $+commands[mise] )); then
  on_demand_completion 'mise' 'mise completion zsh'
fi

# Terraform
if (( $+commands[terraform] )); then
  complete -o nospace -C terraform terraform
fi

# uv
on_demand_completion 'uv' 'uv generate-shell-completion zsh'

# UI
if (( $+commands[starship] )); then
  eval "$(starship init zsh)"
fi

if [[ $- == *i* ]]; then
  if (( $+commands[fzf] )); then
    source <(fzf --zsh)
  fi
  if (( $+commands[zoxide] )); then
    eval "$(zoxide init zsh --cmd cd)"
  fi
  alias grep='rg'
fi
